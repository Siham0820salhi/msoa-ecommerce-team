DATABASE_URL=sqlite:///./payments.db
PORT=8085

# LAB 4 - RabbitMQ (asynchronous shipment events)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
RABBITMQ_QUEUE=shipment.requests
RABBITMQ_DLX=shipment.dlx
# Set to false to run the API without the background publisher (tests, demos)
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL=5
OUTBOX_BATCH_SIZE=20
OUTBOX_BACKOFF_MIN=1
OUTBOX_BACKOFF_MAX=30
# Orders is read (best effort) to enrich events with the delivery address
ORDERS_URL=http://localhost:8084
ORDERS_TIMEOUT=2
# Must match Orders' INTERNAL_API_KEY (service-to-service authentication)
INTERNAL_API_KEY=msoa-internal-dev-key
