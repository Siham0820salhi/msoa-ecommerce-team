DATABASE_URL=sqlite:///./orders.db
PORT=8084

# URLs of the services called by Orders
AUTH_URL=http://localhost:8081
CATALOG_URL=http://localhost:8082
INVENTORY_URL=http://localhost:8083
SHIPPING_URL=http://localhost:8086
HTTP_TIMEOUT=5

# remote = validate the Bearer token with Auth (default, required by CONTRACT.md)
# disabled = DEV ONLY, no authentication (useful while Auth is not ready)
AUTH_MODE=remote

# Shared secret sent by Payments / Shipping in the X-Service-Key header
INTERNAL_API_KEY=msoa-internal-dev-key

# Only the Payments service (X-Service-Key) may set an order to PAID
PAID_REQUIRES_SERVICE_KEY=true

# Before cancelling a PAID order, ask Shipping if the parcel already left
SHIPPING_CHECK_ON_CANCEL=true

# LAB 4
INVENTORY_GRPC_TARGET=localhost:50051
GRPC_TIMEOUT=5
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
