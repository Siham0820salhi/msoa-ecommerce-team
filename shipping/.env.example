DATABASE_URL=sqlite:///./shipping.db
PORT=8086

# LAB 4 - RabbitMQ (asynchronous shipment events)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
RABBITMQ_QUEUE=shipment.requests
RABBITMQ_DLX=shipment.dlx
RABBITMQ_DLQ=shipment.requests.dlq
CONSUMER_MAX_ATTEMPTS=5
CONSUMER_RETRY_DELAY=2
CONSUMER_PREFETCH=1
# Fallback source for the delivery address when the event carries none
ORDERS_URL=http://localhost:8084
ORDERS_TIMEOUT=2
# Must match Orders' INTERNAL_API_KEY (service-to-service authentication)
INTERNAL_API_KEY=msoa-internal-dev-key
